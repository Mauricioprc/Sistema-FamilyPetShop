# ============================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SEUS VALORES
# NUNCA compartilhe o .env real!
# ============================================================

# Chave secreta — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_AQUI

# Credenciais do administrador
ADMIN_USERNAME=seu_usuario

# Hash da senha — gere com: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA_SENHA'))"
ADMIN_PASSWORD_HASH=GERE_O_HASH_AQUI

# Ambiente: development | production
FLASK_ENV=development

# Debug (nunca True em produção)
DEBUG=False

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rate limiting (memory:// para dev, redis://localhost:6379 para produção)
RATELIMIT_STORAGE_URL=memory://

# Onde ficam o banco (petshop.db) e a pasta de uploads. Deixe em branco em
# dev local (usa instance/ e static/uploads do próprio projeto). Em
# produção com disco persistente (ex: Render), aponte para dentro dele:
# INSTANCE_DIR=/var/data/instance
# UPLOAD_FOLDER=/var/data/uploads
INSTANCE_DIR=
UPLOAD_FOLDER=

# Cloudflare Turnstile (CAPTCHA dos formulários públicos: agendamento e avaliação)
# Crie um site em https://dash.cloudflare.com/?to=/:account/turnstile e cole as chaves aqui.
# Sem essas chaves os formulários públicos ficam bloqueados por segurança (fail closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup automático no Google Drive (opcional, além da cópia local em instance/backups)
# Veja o passo a passo completo no README.md ("Backup do banco de dados").
# GOOGLE_SERVICE_ACCOUNT_FILE: caminho do JSON da Service Account (ex: instance/google-service-account.json)
# GOOGLE_SERVICE_ACCOUNT_JSON: alternativa ao arquivo — cole o conteúdo do JSON
#   direto aqui (útil em plataformas sem disco persistente pro arquivo, ex: Render).
#   Se definida, tem prioridade sobre GOOGLE_SERVICE_ACCOUNT_FILE.
# GOOGLE_DRIVE_FOLDER_ID: ID da pasta do Drive (compartilhada com o e-mail da Service Account)
# Deixe em branco para desativar o envio ao Drive (o backup local continua normal).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
